// Covers a uniform buffer_type descriptor in a structured resourceheap.
#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_structured_descriptor_heap : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(buffer_type, scalar) uniform UBO {
    uint x;
};

layout(buffer_type, scalar) buffer SSBO {
    uint y;
};

layout(heap_offset = 0) resourceheap Heap {
    UBO ubo;
    SSBO ssbo;
} heap;

void main()
{
    heap.ssbo.y = heap.ubo.x;
}
