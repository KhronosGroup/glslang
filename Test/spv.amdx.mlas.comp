#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_spirv_intrinsics : require

spirv_instruction(extensions = ["SPV_AMDX_multi_level_acceleration_structure"], capabilities = [5192], id = 5197)
uint rayQueryGetIntersectionInstanceLevelAMDX(spirv_by_reference rayQueryEXT query, uint intersection);
spirv_instruction(extensions = ["SPV_AMDX_multi_level_acceleration_structure"], capabilities = [5192], id = 5198)
uint rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(spirv_by_reference rayQueryEXT query, uint intersection, uint level);
spirv_instruction(extensions = ["SPV_AMDX_multi_level_acceleration_structure"], capabilities = [5192], id = 5199)
uint rayQueryGetIntersectionInstanceIdAtLevelAMDX(spirv_by_reference rayQueryEXT query, uint intersection, uint level);
spirv_instruction(extensions = ["SPV_AMDX_multi_level_acceleration_structure"], capabilities = [5192], id = 5200)
mat4x3 rayQueryGetIntersectionObjectToWorldAtLevelAMDX(spirv_by_reference rayQueryEXT query, uint intersection, uint level);
spirv_instruction(extensions = ["SPV_AMDX_multi_level_acceleration_structure"], capabilities = [5192], id = 5201)
mat4x3 rayQueryGetIntersectionWorldToObjectAtLevelAMDX(spirv_by_reference rayQueryEXT query, uint intersection, uint level);

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, std430) buffer Output {
    uint instanceLevels[2];
    uvec2 instanceProperties[2];
    mat4x3 transforms[4];
} result;

void main()
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, 0u, 0xffu, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 100.0);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            result.instanceLevels[0] = rayQueryGetIntersectionInstanceLevelAMDX(query, 0u);
            result.instanceProperties[0] = uvec2(rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, 0u, 0u),
                                                 rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, 0u, 0u));
            result.transforms[0] = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, 0u, 0u);
            result.transforms[1] = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, 0u, 0u);
            rayQueryConfirmIntersectionEXT(query);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        result.instanceLevels[1] = rayQueryGetIntersectionInstanceLevelAMDX(query, 1u);
        for (uint level = 0u; level < result.instanceLevels[1]; ++level) {
            result.instanceProperties[1] = uvec2(rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, 1u, level),
                                                 rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, 1u, level));
            result.transforms[2] = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, 1u, level);
            result.transforms[3] = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, 1u, level);
        }
    }
}
