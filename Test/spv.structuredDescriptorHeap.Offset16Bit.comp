#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_structured_descriptor_heap : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 1) in;

layout(constant_id = 0) const uint16_t unsignedOffset = uint16_t(32768);
layout(constant_id = 1) const int16_t signedOffset = int16_t(64);

layout(buffer_type) buffer DataBuffer {
    uint data;
};

layout(heap_offset = unsignedOffset) resourceheap UnsignedHeap {
    DataBuffer dataBuffer;
} unsignedHeap;

layout(heap_offset = signedOffset) resourceheap SignedHeap {
    uint count;
    DataBuffer dataBuffer;
} signedHeap;

void main()
{
    unsignedHeap.dataBuffer.data = signedHeap.dataBuffer.data;
}
