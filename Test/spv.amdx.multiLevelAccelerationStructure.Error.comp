#version 460 core
#extension GL_EXT_ray_query : require

layout(local_size_x = 1) in;
rayQueryEXT query;

void extensionDisabled()
{
    uint count = rayQueryGetIntersectionInstanceLevelAMDX(query, false); // ERROR: MLAS extension disabled
    int customIndex = rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, false, 0u); // ERROR
    int instanceId = rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, false, 0u); // ERROR
    mat4x3 objectToWorld = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, false, 0u); // ERROR
    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, false, 0u); // ERROR
}

#extension GL_AMDX_multi_level_acceleration_structure : require

void nonConstantCommitted(bool committed)
{
    uint count = rayQueryGetIntersectionInstanceLevelAMDX(query, committed); // ERROR: non-constant committed
    int customIndex = rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, committed, 0u); // ERROR
    int instanceId = rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, committed, 0u); // ERROR
    mat4x3 objectToWorld = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, committed, 0u); // ERROR
    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, committed, 0u); // ERROR
}

#extension GL_EXT_ray_query : disable

void baseExtensionDisabled()
{
    uint count = rayQueryGetIntersectionInstanceLevelAMDX(query, false); // ERROR: ray query extension disabled
    int customIndex = rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, false, 0u); // ERROR
    int instanceId = rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, false, 0u); // ERROR
    mat4x3 objectToWorld = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, false, 0u); // ERROR
    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, false, 0u); // ERROR
}

void main() {}
