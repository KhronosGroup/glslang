#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_AMDX_multi_level_acceleration_structure : require

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, std430) buffer Output {
    uint instanceLevels[2];
    ivec2 instanceProperties[2];
    mat4x3 transforms[4];
} result;

void readCommitted(rayQueryEXT query, uint level)
{
    result.instanceProperties[1] = ivec2(rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, true, level),
                                         rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, true, level));
    result.transforms[2] = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, true, level);
    result.transforms[3] = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, true, level);
}

void main()
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, 0u, 0xffu, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 100.0);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            result.instanceLevels[0] = rayQueryGetIntersectionInstanceLevelAMDX(query, false);
            result.instanceProperties[0] = ivec2(rayQueryGetIntersectionInstanceCustomIndexAtLevelAMDX(query, false, 0u),
                                                 rayQueryGetIntersectionInstanceIdAtLevelAMDX(query, false, 0u));
            result.transforms[0] = rayQueryGetIntersectionObjectToWorldAtLevelAMDX(query, false, 0u);
            result.transforms[1] = rayQueryGetIntersectionWorldToObjectAtLevelAMDX(query, false, 0u);
            rayQueryConfirmIntersectionEXT(query);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        result.instanceLevels[1] = rayQueryGetIntersectionInstanceLevelAMDX(query, true);
        for (uint level = 0u; level < result.instanceLevels[1]; ++level)
            readCommitted(query, level);
    }

    rayQueryEXT queries[2];
    rayQueryInitializeEXT(queries[1], topLevelAS, 0u, 0xffu, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 100.0);
    while (rayQueryProceedEXT(queries[1]))
        result.instanceLevels[0] = rayQueryGetIntersectionInstanceLevelAMDX(queries[1], false);
}
