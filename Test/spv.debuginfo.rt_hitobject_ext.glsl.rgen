#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_shader_invocation_reorder : enable

layout(binding = 0, set = 0) uniform accelerationStructureEXT acc0;
layout(location = 0) rayPayloadEXT vec4 payload;

hitObjectEXT globalHitObject;

void main()
{
    hitObjectTraceRayEXT(globalHitObject, acc0, 0U, 0xFFU, 0U, 0U, 0U, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 100.0, 0);

    hitObjectEXT localHitObject;
    hitObjectRecordEmptyEXT(localHitObject);
    hitObjectExecuteShaderEXT(globalHitObject, 0);
}
