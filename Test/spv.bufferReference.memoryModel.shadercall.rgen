#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_ray_tracing : require

layout(buffer_reference, std430) buffer Ref { uint value; };
layout(push_constant) uniform Push { Ref ref; } pc;

// Using shadercallcoherent on a buffer reference requires the
// vulkan memory model

void main()
{
    shadercallcoherent Ref ref = pc.ref;
    ref.value = 5;
}
