#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_NV_shader_invocation_reorder : enable
layout(location = 2) rayPayloadEXT vec4 payload;
layout(location = 2) hitObjectAttributeNV vec4 attr;
layout(binding = 0) uniform accelerationStructureEXT as;
layout(binding = 1) buffer block {
	float op;
};
void main()
{
	hitObjectNV hObj;
	hitObjectTraceRayMotionNV(hObj, as, 1U, 1U, 1U, 1U, 1U, vec3(0.5), 0.5, vec3(1), 1.0, 10.0, 2);       // ERROR, needs GL_NV_ray_tracing_motion_blur
	hitObjectRecordHitMotionNV(hObj, as, 1, 1, 1, 2U, 2U, 2U, vec3(1), 1.0f, vec3(2), 2.0f, 4.0f, 2);       // ERROR, needs GL_NV_ray_tracing_motion_blur
	hitObjectRecordHitWithIndexMotionNV(hObj, as, 1, 1, 1, 2U, 2U, vec3(1), 1.0f, vec3(2), 2.0f, 4.0f, 2);  // ERROR, needs GL_NV_ray_tracing_motion_blur
	hitObjectRecordMissMotionNV(hObj, 1U, vec3(0.5), 2.0, vec3(1.5), 5.0, 8.0f);                            // ERROR, needs GL_NV_ray_tracing_motion_blur
	op = hitObjectGetCurrentTimeNV(hObj);                                                                   // ERROR, needs GL_NV_ray_tracing_motion_blur
}
