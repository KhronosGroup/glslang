#version 460
#extension GL_EXT_ray_tracing : enable
layout(binding = 0, set = 0) uniform accelerationStructureEXT accEXT;
layout(location = 1) rayPayloadEXT vec4 payload;
void main()
{
    // Exercise all ray flags defined in GLSL_EXT_ray_tracing
    //
    // Avoid invalid combinations:
    //	more than one of: Opaque, NoOpaque, CullOpaque, CullNoOpaque
    //  more than one of: SkipTriangles, CullBackFacingTriangles, CullFrontFacingTriangles
    const uint rayFlags1 = gl_RayFlagsNoneEXT | gl_RayFlagsOpaqueEXT |
                           gl_RayFlagsTerminateOnFirstHitEXT;
    const uint rayFlags2 = gl_RayFlagsNoOpaqueEXT |
                           gl_RayFlagsSkipClosestHitShaderEXT;
    const uint rayFlags3 = gl_RayFlagsCullBackFacingTrianglesEXT |
                           gl_RayFlagsCullOpaqueEXT;
    const uint rayFlags4 = gl_RayFlagsCullFrontFacingTrianglesEXT |
                           gl_RayFlagsCullNoOpaqueEXT;

    const int payloadId = 1;
    traceRayEXT(accEXT, rayFlags1, 0, 1, 1, 0, vec3(0.0f), 0.5f, vec3(1.0f), 0.75f, payloadId);
    traceRayEXT(accEXT, rayFlags2, 0, 1, 1, 0, vec3(0.0f), 0.5f, vec3(1.0f), 0.75f, payloadId);
    traceRayEXT(accEXT, rayFlags3, 0, 1, 1, 0, vec3(0.0f), 0.5f, vec3(1.0f), 0.75f, payloadId);
    traceRayEXT(accEXT, rayFlags4, 0, 1, 1, 0, vec3(0.0f), 0.5f, vec3(1.0f), 0.75f, payloadId);
}
