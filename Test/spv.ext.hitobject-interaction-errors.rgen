#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_shader_invocation_reorder : enable
layout(location = 2) rayPayloadEXT vec4 payload;
layout(binding = 0) uniform accelerationStructureEXT as;
layout(binding = 1) buffer block {
	float op;
	vec3 pos;
};
void main()
{
	hitObjectEXT hObj;
	hitObjectTraceRayMotionEXT(hObj, as, 1U, 1U, 1U, 1U, 1U, vec3(0.5), 0.5, vec3(1), 1.0, 10.0, 2);      // ERROR, needs GL_NV_ray_tracing_motion_blur
	hitObjectRecordMissMotionEXT(hObj, 1U, 1U, vec3(0.5), 2.0, vec3(1.5), 5.0, 8.0f);                       // ERROR, needs GL_NV_ray_tracing_motion_blur
	hitObjectTraceMotionReorderExecuteEXT(hObj, as, 1U, 1U, 1U, 1U, 1U, vec3(0.5), 0.5, vec3(1), 1.0, 10.0, 1U, 1U, 2); // ERROR, needs GL_NV_ray_tracing_motion_blur
	op = hitObjectGetCurrentTimeEXT(hObj);                                                                  // ERROR, needs GL_NV_ray_tracing_motion_blur
	vec3 positions[3];
	hitObjectGetIntersectionTriangleVertexPositionsEXT(hObj, positions);                                    // ERROR, needs GL_EXT_ray_tracing_position_fetch
	pos = positions[0];
}
